NEO4J_PASSWORD=grandstack-dev

# Only for the Aura setup (compose.aura.yaml). Make a key with: openssl rand -base64 32
# It seals the Aura client secret and stored instance passwords. Keep it: a new key cannot open what the old one sealed.
SECRET_KEY=
# The fake Aura is used unless this is set. For a real account: https://api.neo4j.io
# AURA_BASE_URL=

